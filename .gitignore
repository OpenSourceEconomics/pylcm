# Native outputs live in an install payload, never in the source package. The
# standalone hook uses this build-only directory for diagnostics.
.pylcm-native-build/
# Everything link.exe emits alongside the installed Windows DLL.
*.def
*.dll
*.exp
*.lib
*.obj
# Compiler reports written beside each built kernel: absolute paths and toolchain
# versions from whichever machine built it, regenerated on every build.
*.so.build.log
*.dll.build.log
*$py.class

