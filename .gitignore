coverage.xml
htmlcov/

# Version file (generated by hatch-vcs)
src/*/_version.py
src/_lcm/version.py
tmp/

# Agent working files
docs/superpowers/
.superpowers/
# Inputs and evidence for the external numerical audit: the profile contract, the
# completion record, resource-gate scripts and their raw observations. They must sit
# under the project root — the audit tooling takes real project paths, not a staged
# side directory — but they are per-round working files, not repository content.
.pro-audit/

# JUnit XML reports written by test runners (unique path per invocation).
reports/

# Local review-tool config, per checkout rather than repository content.
.roborev.toml
